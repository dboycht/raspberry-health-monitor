[Unit]
Description=Raspberry Health Monitor (elder care IoT monitor)
Documentation=file:///home/pi/raspberry-health-monitor/README.md
After=network-online.target
Wants=network-online.target
# ⚠️ 这一行**必须待在 [Unit] 段里**（2026-10-01，ERROR.md **E74**）
#    它原本被写在 [Service] 段里 ⇒ `systemd-analyze verify` 报
#    "Unknown key 'After' in section [Service], ignoring." ⇒ **被静默忽略**，
#    于是注释里承诺的"等 /dev/i2c-1 就绪再启动"根本没生效
#    （启动早于节点创建时靠 Restart=always 兜底重试 —— 能自愈，但白费一轮、
#      而且日志里留下"打不开 I2C"的错，看着像硬件坏了）。
#    判据：**systemd 只认"段 + 键"的组合；写错段不是报错，是"忽略"**。
After=dev-i2c-1.device

[Service]
Type=simple
# ⚠️ 请把 WorkingDirectory 与 ExecStart 的路径改成你树莓派上的实际路径
#    也可以用仓库里的 install-service.sh 自动改好：
#      cd <项目>/rpi/deploy && sudo bash install-service.sh
WorkingDirectory=/home/pi/raspberry-health-monitor/rpi
# --real = 访问真实硬件；--store 指定历史库位置
ExecStart=/usr/bin/python3 -m health_monitor serve --real --host 0.0.0.0 --port 8080 --store /home/pi/health-monitor-data/history.db
# 需要 token 时加：--token <你的口令>
# ⚠️ 注意：`python3 -m health_monitor` 需要工作目录在 rpi/（包根所在处）——见上面的 WorkingDirectory

# 用普通用户跑（需要访问 /dev/i2c-1、/dev/spidev0.*、GPIO）
# ⚠️ Debian 13 / Raspberry Pi OS Bookworm 之后，i2c/spi 设备属组是 i2c / spi，
#    用户需要在这两个组里才不需要 root（install-service.sh 会自动加）
User=pi
Group=pi
SupplementaryGroups=i2c spi gpio

Restart=always
RestartSec=5
# 让 systemd 把日志收进 journalctl
StandardOutput=journal
StandardError=journal
SyslogIdentifier=health-monitor

[Install]
WantedBy=multi-user.target
