<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 访问树莓派 HTTP 接口必需（协议 §5.6）。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 用来判断"当前没连 WiFi，肯定连不上树莓派"，给出更友好的提示。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".HealthMonitorApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.HealthMonitor"
        android:usesCleartextTraffic="true"
        tools:targetApi="m"
        tools:ignore="UnusedAttribute">

        <!-- 局域网是明文 http，必须放行（Android 9+ 否则直接拒绝，
             报 CLEARTEXT communication not permitted，见协议 §5.7）。 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:networkSecurityConfig="@xml/network_security_config"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
